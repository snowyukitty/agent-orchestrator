{
  "name": "agent-orchestrator",
  "productName": "Agent Orchestrator",
  "version": "0.4.0",
  "private": true,
  "description": "Multi-account desktop workflow orchestrator for local CLI AI agents",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/snowyukitty/agent-orchestrator.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "visual": "electron . --visual-test",
    "promo:capture": "node scripts/capture-promo.mjs",
    "smoke": "electron . --smoke-test",
    "test": "npm run test:unit && npm run test:app",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:app": "electron . --self-test",
    "check": "node scripts/check-syntax.js && node scripts/check-docs.js",
    "verify:direct-argv": "node scripts/manual-verify-direct-argv.js",
    "verify:routed": "node scripts/manual-verify-routed.js",
    "icons": "electron scripts/build-icons.js",
    "build": "electron-packager . AgentOrchestrator --platform=win32 --arch=x64 --overwrite --out=dist --icon=src/assets/icon.ico --ignore=\"(dist|scripts|tests|docs|mcps|\\.git|\\.github|icon-source\\.png|AGENTS\\.md|README\\.md|CONTRIBUTING\\.md|SECURITY\\.md|package-lock\\.json|.*\\.log|.*\\.bat)\" --asar.unpackDir=node_modules/node-pty --extra-resource=src/main/codex-notify.ps1 && node scripts/verify-package.mjs",
    "verify": "npm run check && npm test && npm audit --audit-level=moderate && npm run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@electron/packager": "^20.3.0",
    "electron": "^43.4.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "sortablejs": "^1.15.6"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "node-pty@1.1.0": true
  }
}
